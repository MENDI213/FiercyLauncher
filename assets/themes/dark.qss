* { font-family: "Segoe UI", "Inter", sans-serif; font-size: 10pt; }
QWidget { color: #e8edf8; background: transparent; }
#WindowRoot { background: #0b0f18; border: 1px solid #283247; border-radius: 18px; }
#TitleBar { background: #0d1320; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom: 1px solid #202a3b; }
#BrandMark { background: #8b6cff; color: #ffffff; border-radius: 9px; font-size: 14pt; font-weight: 900; }
#WindowTitle { color: #f5f7ff; font-size: 9pt; font-weight: 800; letter-spacing: 1px; }
#WindowSubtitle { color: #7f8aa2; font-size: 8pt; }
QToolButton#WindowControl { background: transparent; color: #9ba8bf; border: 0; border-radius: 8px; min-width: 34px; min-height: 30px; font-size: 12pt; }
QToolButton#WindowControl:hover { background: #263149; color: #ffffff; }
QToolButton#CloseControl:hover { background: #d84d62; color: #ffffff; }
#Sidebar { background: #0e1420; border-right: 1px solid #202a3b; border-bottom-left-radius: 18px; }
#NavButton { text-align: left; padding: 12px 14px; border: 0; border-radius: 10px; color: #9ca9c0; background: transparent; font-weight: 600; }
#NavButton:hover { background: #192336; color: #ffffff; }
#NavButton[active="true"] { background: #292344; color: #c4b4ff; border: 1px solid #57469b; }
#PageHeading { color: #f7f8ff; font-size: 21pt; font-weight: 800; }
#Eyebrow { color: #9b87f3; font-size: 8pt; font-weight: 800; letter-spacing: 1.7px; }
#Muted { color: #8d9ab2; }
#Card { background: #131b2a; border: 1px solid #27344b; border-radius: 16px; }
#HeroCard { background: #171d32; border: 1px solid #3a3760; border-radius: 18px; }
#HeroTitle { color: #ffffff; font-size: 25pt; font-weight: 900; }
#HeroCopy { color: #b2bdd1; font-size: 10pt; }
#PrimaryButton { color: #ffffff; background: #795de7; border: 1px solid #927cff; border-radius: 11px; padding: 12px 20px; font-weight: 800; }
#PrimaryButton:hover { background: #896ff2; }
#PrimaryButton:disabled { background: #45415c; color: #8b879d; border-color: #45415c; }
#SecondaryButton { color: #dce4f4; background: #202b40; border: 1px solid #35445e; border-radius: 10px; padding: 10px 15px; font-weight: 650; }
#SecondaryButton:hover { background: #2a3953; border-color: #61759b; }
#DangerButton { color: #ffc5ca; background: #3a202b; border: 1px solid #663341; border-radius: 10px; padding: 10px 14px; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit { background: #0c1320; border: 1px solid #303d54; border-radius: 9px; color: #e8edf8; padding: 9px 11px; selection-background-color: #7359d2; outline: 0; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border: 1px solid #9b87f3; outline: 0; }
QComboBox { combobox-popup: 0; padding-right: 32px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; border: 0; width: 30px; background: transparent; }
QComboBox::down-arrow { width: 7px; height: 7px; border-right: 2px solid #8998b2; border-bottom: 2px solid #8998b2; margin-right: 10px; margin-top: -3px; }
QComboBox QAbstractItemView { background: #141e30; border: 0; selection-background-color: #594b93; color: #e8edf8; outline: 0; padding: 4px; }
QComboBoxPrivateContainer { background: #141e30; border: 0; padding: 0; margin: 0; }
QCheckBox { spacing: 9px; color: #c3cde0; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1px solid #576680; background: #0b1320; }
QCheckBox::indicator:checked { background: #8065ea; border-color: #a18cff; }
QProgressBar { background: #0a111d; border: 1px solid #2c3a50; border-radius: 7px; height: 13px; text-align: center; color: #e9e5ff; }
QProgressBar::chunk { background: #8b70ee; border-radius: 6px; }
QPlainTextEdit { font-family: "Cascadia Code", "Consolas", monospace; font-size: 9pt; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 3px; }
QScrollBar::handle:vertical { background: #35425a; border-radius: 4px; min-height: 25px; }
QScrollBar::handle:vertical:hover { background: #5a6681; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSizeGrip { background: transparent; width: 14px; height: 14px; }
QLabel#Pill { background: #1e2c3e; border: 1px solid #334963; border-radius: 10px; padding: 5px 9px; color: #a9e6d4; font-weight: 700; }
QLabel#AccountPill { background: #262344; border: 1px solid #4b437a; border-radius: 10px; padding: 7px 10px; color: #d5caff; font-weight: 700; }
QLabel#StatusText { color: #8da0be; font-size: 9pt; }
QLabel#SmallNote { color: #7d8ba4; font-size: 8pt; }
QFrame#Divider { background: #253149; max-height: 1px; }
QFrame#TitleBar, QFrame#Sidebar { border: none; }
QPushButton { outline: none; }
QPushButton:focus { border-color: #9b87f3; }
QToolTip { color: #f4f6ff; background: #1a2435; border: 1px solid #596985; padding: 5px; }

QLabel#SkinAvatar { background: #202b40; border: 1px solid #3c4a63; border-radius: 15px; color: #c6b8ff; font-size: 30pt; font-weight: 900; }

QLabel#PromoBanner { background: #101827; border: 1px solid #2d3a52; border-radius: 12px; padding: 6px; }

/* Consistent themed popups and lists: suppress native white focus/frame borders. */
QComboBox QAbstractItemView, QAbstractItemView, QListView, QTreeView {
    background: #141e30;
    color: #e8edf8;
    border: 0;
    outline: 0;
    selection-background-color: #594b93;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item, QAbstractItemView::item, QListWidget::item {
    background: transparent;
    color: #e8edf8;
    border: 0;
    padding: 8px 10px;
    min-height: 24px;
}
QComboBox QAbstractItemView::item:hover, QAbstractItemView::item:hover, QListWidget::item:hover {
    background: #202d43;
    color: #ffffff;
}
QComboBox QAbstractItemView::item:selected, QAbstractItemView::item:selected, QListWidget::item:selected {
    background: #594b93;
    color: #ffffff;
    border: 0;
}
QComboBox QAbstractItemView:focus, QListWidget:focus, QListView:focus, QTreeView:focus {
    outline: 0;
}
QListWidget {
    background: #0c1320;
    color: #e8edf8;
    border: 1px solid #303d54;
    border-radius: 10px;
    outline: 0;
    padding: 5px;
    alternate-background-color: #111a29;
}
QListWidget#ModrinthResultsList {
    background: #0b1220;
    border: 1px solid #27344b;
    padding: 8px;
}
QComboBoxPrivateContainer {
    background: #141e30;
    border: 0;
    padding: 0;
    margin: 0;
}
QFrame#ModrinthProjectCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #30253e, stop:0.48 #202a3f, stop:1 #183b46);
    border: 1px solid #665076; border-left: 6px solid #b58cff; border-radius: 18px;
}
QFrame#ModrinthProjectCard:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #42304f, stop:0.52 #27374d, stop:1 #1c4b55);
    border: 1px solid #ffad86; border-left: 6px solid #ff9b70;
}
QFrame#ModrinthProjectCard[projectType="modpack"] { border-left-color: #ffb34f; background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #453126,stop:1 #2d2941); }
QFrame#ModrinthProjectCard[projectType="resourcepack"] { border-left-color: #4fe0b0; background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #1e403b,stop:1 #202f43); }
QFrame#ModrinthProjectCard[projectType="shader"] { border-left-color: #69b9ff; background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #243b5b,stop:1 #292942); }
QLabel#ModrinthProjectIcon { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8457bd, stop:1 #217f9b); border: 1px solid #a98ad0; border-radius: 16px; color: #ffffff; font-size: 21pt; font-weight: 900; }
QLabel#ModrinthProjectTitle { color: #ffffff; font-size: 12pt; font-weight: 900; }
QLabel#ModrinthProjectAuthor { color: #d5c9e0; font-size: 9pt; }
QLabel#ModrinthProjectDescription { color: #f0eaf4; font-size: 9.5pt; }
QLabel#ModrinthProjectMeta { color: #d4c7df; font-size: 9pt; font-weight: 800; }
QLabel#ModrinthProjectTags { color: #ffd09b; font-size: 9pt; font-weight: 900; }
QLabel#ModrinthProjectTypeBadge { background: #55396a; border: 1px solid #a57ac2; border-radius: 8px; color: #ffe5ff; padding: 2px 8px; font-size: 8pt; font-weight: 900; }
QFrame#ModrinthProjectCard[projectType="modpack"] QLabel#ModrinthProjectTypeBadge { background: #68451f; border-color: #d19a48; color: #ffe5b7; }
QFrame#ModrinthProjectCard[projectType="resourcepack"] QLabel#ModrinthProjectTypeBadge { background: #195849; border-color: #43bf9b; color: #c8ffec; }
QFrame#ModrinthProjectCard[projectType="shader"] QLabel#ModrinthProjectTypeBadge { background: #214b76; border-color: #61a9e8; color: #d8efff; }
QLabel#ModrinthProjectState { color: #ded5e8; font-size: 8.5pt; font-weight: 800; }
QLabel#ModrinthProjectState[state="queued"] { color: #ffd27e; font-weight: 900; }
QLabel#ModrinthProjectState[state="downloading"] { color: #a9e9ff; font-weight: 900; }
QLabel#ModrinthProjectState[state="installed"] { color: #8df0bb; font-weight: 900; }
QLabel#ModrinthProjectState[state="failed"] { color: #ffadb5; font-weight: 900; }
QPushButton#ModrinthActionButton { color: #fff; background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8759d8, stop:1 #ed668f); border: 1px solid #dda0ff; border-radius: 12px; padding: 8px 13px; font-weight: 900; }
QPushButton#ModrinthActionButton:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a477eb, stop:1 #ff8eaa); }
QPushButton#ModrinthQueuedButton, QPushButton#ModrinthDownloadingButton { color: #fff0c7; background: #5a4024; border: 1px solid #d29b50; border-radius: 12px; padding: 8px 13px; font-weight: 900; }
QPushButton#ModrinthInstalledButton { color: #d4ffeb; background: #1c624a; border: 1px solid #55c48e; border-radius: 12px; padding: 8px 13px; font-weight: 900; }
QPushButton#ModrinthRetryButton { color: #ffe1e5; background: #653247; border: 1px solid #df7890; border-radius: 12px; padding: 8px 13px; font-weight: 900; }
QProgressBar#ModrinthCardProgress { background: #47394f; border: 0; border-radius: 3px; }
QProgressBar#ModrinthCardProgress::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8e67f4, stop:0.55 #df70bc, stop:1 #ffb269); border-radius: 3px; }
QWidget#ModrinthCatalogContent { background: transparent; }
QScrollArea#ModrinthCatalogScroll { background: transparent; border: 0; }
QLabel#ModrinthGalleryImage { background: #101827; border: 1px solid #303d54; border-radius: 9px; color: #8d9ab2; }


/* Modrinth catalog and project detail page */
QPushButton#ModTypeFilter { color: #aab6cb; background: #141e30; border: 1px solid #303d54; border-radius: 10px; padding: 10px 14px; font-weight: 800; }
QPushButton#ModTypeFilter:hover { background: #202d43; border-color: #6656a4; color: #ffffff; }
QPushButton#ModTypeFilter:checked { color: #ffffff; background: #594b93; border: 1px solid #9b87f3; }
QFrame#ModrinthDetailsHeader, QFrame#ModrinthDetailsFooter { background: #131b2a; border: 1px solid #27344b; border-radius: 12px; }
QScrollArea#ModrinthDetailsScroll, QScrollArea#ModrinthGalleryScroll { background: transparent; border: 0; }
QTextBrowser#ModrinthProjectBody { background: #0c1320; color: #e8edf8; border: 1px solid #27344b; border-radius: 10px; padding: 10px; selection-background-color: #594b93; }
QLabel#SectionTitle { color: #f5f7ff; font-size: 12pt; font-weight: 800; padding: 2px 0; }
QListWidget#ProfileModsList { background: #0c1320; border: 1px solid #303d54; border-radius: 10px; padding: 5px; }
QListWidget#ProfileModsList::item { border: 0; padding: 2px; }
QListWidget#ProfileModsList::item:selected { background: #202b40; border-radius: 8px; }
QPushButton#InstalledModTitle { color: #e8edf8; font-weight: 700; }
QPushButton#InstalledModTitle:hover { color: #a99aff; }

