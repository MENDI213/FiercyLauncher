* { font-family: "Segoe UI", "Inter", sans-serif; font-size: 10pt; }
QWidget { color: #202a3b; background: transparent; }
#WindowRoot { background: #f2f5fb; border: 1px solid #d3dbea; border-radius: 18px; }
#TitleBar { background: #e9eef7; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom: 1px solid #d8e0ed; }
#BrandMark { background: #7658d9; color: #ffffff; border-radius: 9px; font-size: 14pt; font-weight: 900; }
#WindowTitle { color: #222c3d; font-size: 9pt; font-weight: 800; letter-spacing: 1px; }
#WindowSubtitle { color: #748198; font-size: 8pt; }
QToolButton#WindowControl { background: transparent; color: #5b6880; border: 0; border-radius: 8px; min-width: 34px; min-height: 30px; font-size: 12pt; }
QToolButton#WindowControl:hover { background: #d8e0ef; color: #172238; }
QToolButton#CloseControl:hover { background: #d84d62; color: white; }
#Sidebar { background: #e9eef7; border-right: 1px solid #d8e0ed; border-bottom-left-radius: 18px; }
#NavButton { text-align: left; padding: 12px 14px; border: 0; border-radius: 10px; color: #62718a; background: transparent; font-weight: 600; }
#NavButton:hover { background: #dce4f2; color: #263247; }
#NavButton[active="true"] { background: #e0dafa; color: #5944a6; border: 1px solid #b9abea; }
#PageHeading { color: #1e2a3d; font-size: 21pt; font-weight: 800; }
#Eyebrow { color: #6c56c6; font-size: 8pt; font-weight: 800; letter-spacing: 1.7px; }
#Muted { color: #6f7e96; }
#Card { background: #ffffff; border: 1px solid #dce3ef; border-radius: 16px; }
#HeroCard { background: #e5e7f7; border: 1px solid #c9c9ec; border-radius: 18px; }
#HeroTitle { color: #1f2a3e; font-size: 25pt; font-weight: 900; }
#HeroCopy { color: #5e6a83; font-size: 10pt; }
#PrimaryButton { color: white; background: #7658d9; border: 1px solid #8f77e7; border-radius: 11px; padding: 12px 20px; font-weight: 800; }
#PrimaryButton:hover { background: #684acb; }
#PrimaryButton:disabled { background: #c6c1d8; color: #f2f1f8; border-color: #c6c1d8; }
#SecondaryButton { color: #3c4961; background: #edf1f8; border: 1px solid #d2dbea; border-radius: 10px; padding: 10px 15px; font-weight: 650; }
#SecondaryButton:hover { background: #dfe6f2; border-color: #b7c4da; }
#DangerButton { color: #a73545; background: #fff0f1; border: 1px solid #f0c4ca; border-radius: 10px; padding: 10px 14px; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit { background: #ffffff; border: 1px solid #d1dbea; border-radius: 9px; color: #253147; padding: 9px 11px; selection-background-color: #7658d9; outline: 0; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border: 1px solid #8269dc; outline: 0; }
QComboBox { combobox-popup: 0; padding-right: 32px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; border: 0; width: 30px; background: transparent; }
QComboBox::down-arrow { width: 7px; height: 7px; border-right: 2px solid #748198; border-bottom: 2px solid #748198; margin-right: 10px; margin-top: -3px; }
QComboBox QAbstractItemView { background: #ffffff; border: 0; selection-background-color: #e6e0fb; color: #253147; outline: 0; padding: 4px; }
QComboBoxPrivateContainer { background: #ffffff; border: 0; padding: 0; margin: 0; }
QCheckBox { spacing: 9px; color: #42506a; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1px solid #9eabc0; background: white; }
QCheckBox::indicator:checked { background: #7658d9; border-color: #7658d9; }
QProgressBar { background: #e5ebf5; border: 1px solid #d0daea; border-radius: 7px; height: 13px; text-align: center; color: #4e3d98; }
QProgressBar::chunk { background: #8068df; border-radius: 6px; }
QPlainTextEdit { font-family: "Cascadia Code", "Consolas", monospace; font-size: 9pt; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 3px; }
QScrollBar::handle:vertical { background: #c1cbdb; border-radius: 4px; min-height: 25px; }
QScrollBar::handle:vertical:hover { background: #9eacc2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSizeGrip { background: transparent; width: 14px; height: 14px; }
QLabel#Pill { background: #e6f5ed; border: 1px solid #bfe1cf; border-radius: 10px; padding: 5px 9px; color: #26724c; font-weight: 700; }
QLabel#AccountPill { background: #eee9ff; border: 1px solid #d4c9fa; border-radius: 10px; padding: 7px 10px; color: #5844a0; font-weight: 700; }
QLabel#StatusText { color: #74839b; font-size: 9pt; }
QLabel#SmallNote { color: #7a879b; font-size: 8pt; }
QFrame#Divider { background: #dce3ef; max-height: 1px; }
QFrame#TitleBar, QFrame#Sidebar { border: none; }
QPushButton { outline: none; }
QPushButton:focus { border-color: #8269dc; }
QToolTip { color: #263147; background: #ffffff; border: 1px solid #cbd5e4; padding: 5px; }

QLabel#SkinAvatar { background: #e9eef7; border: 1px solid #cbd5e5; border-radius: 15px; color: #7658d9; font-size: 30pt; font-weight: 900; }

QLabel#PromoBanner { background: #edf1f8; border: 1px solid #d4deec; border-radius: 12px; padding: 6px; }

/* Consistent themed popups and lists: suppress native white focus/frame borders. */
QComboBox QAbstractItemView, QAbstractItemView, QListView, QTreeView {
    background: #ffffff;
    color: #253147;
    border: 0;
    outline: 0;
    selection-background-color: #e6e0fb;
    selection-color: #253147;
}
QComboBox QAbstractItemView::item, QAbstractItemView::item, QListWidget::item {
    background: transparent;
    color: #253147;
    border: 0;
    padding: 8px 10px;
    min-height: 24px;
}
QComboBox QAbstractItemView::item:hover, QAbstractItemView::item:hover, QListWidget::item:hover {
    background: #eef1f8;
    color: #202a3b;
}
QComboBox QAbstractItemView::item:selected, QAbstractItemView::item:selected, QListWidget::item:selected {
    background: #e6e0fb;
    color: #3a2b79;
    border: 0;
}
QComboBox QAbstractItemView:focus, QListWidget:focus, QListView:focus, QTreeView:focus {
    outline: 0;
}
QListWidget {
    background: #ffffff;
    color: #253147;
    border: 1px solid #d1dbea;
    border-radius: 10px;
    outline: 0;
    padding: 5px;
    alternate-background-color: #f6f8fc;
}
QListWidget#ModrinthResultsList {
    background: #f7f9fd;
    border: 1px solid #dce3ef;
    padding: 8px;
}
QComboBoxPrivateContainer {
    background: #ffffff;
    border: 0;
    padding: 0;
    margin: 0;
}
QFrame#ModrinthProjectCard { background: #ffffff; border: 1px solid #dce3ef; border-radius: 13px; }
QFrame#ModrinthProjectCard:hover { background: #f6f7fc; border-color: #a89ae2; }
QLabel#ModrinthProjectIcon { background: #e9eef7; border: 1px solid #cbd5e5; border-radius: 12px; color: #7658d9; font-size: 20pt; font-weight: 900; }
QLabel#ModrinthProjectTitle { color: #1e2a3d; font-size: 11pt; font-weight: 800; }
QLabel#ModrinthProjectDescription { color: #5e6a83; font-size: 9pt; }
QLabel#ModrinthProjectMeta { color: #748198; font-size: 8pt; }
QLabel#ModrinthProjectTags { color: #8269dc; font-size: 8pt; font-weight: 700; }
QWidget#ModrinthCatalogContent { background: transparent; }
QScrollArea#ModrinthCatalogScroll { background: transparent; border: 0; }
QLabel#ModrinthGalleryImage { background: #edf1f8; border: 1px solid #d1dbea; border-radius: 9px; color: #6f7e96; }


/* Modrinth catalog and project detail page */
QPushButton#ModTypeFilter { color: #5e6a83; background: #f7f9fd; border: 1px solid #d1dbea; border-radius: 10px; padding: 10px 14px; font-weight: 800; }
QPushButton#ModTypeFilter:hover { background: #edf1f8; border-color: #a89ae2; color: #1e2a3d; }
QPushButton#ModTypeFilter:checked { color: #ffffff; background: #7658d9; border: 1px solid #9f8be8; }
QFrame#ModrinthDetailsHeader, QFrame#ModrinthDetailsFooter { background: #ffffff; border: 1px solid #dce3ef; border-radius: 12px; }
QScrollArea#ModrinthDetailsScroll, QScrollArea#ModrinthGalleryScroll { background: transparent; border: 0; }
QTextBrowser#ModrinthProjectBody { background: #ffffff; color: #1e2a3d; border: 1px solid #dce3ef; border-radius: 10px; padding: 10px; selection-background-color: #7658d9; }
QLabel#SectionTitle { color: #1e2a3d; font-size: 12pt; font-weight: 800; padding: 2px 0; }
QListWidget#ProfileModsList { background: #ffffff; border: 1px solid #dce3ef; border-radius: 10px; padding: 5px; }
QListWidget#ProfileModsList::item { border: 0; padding: 2px; }
QListWidget#ProfileModsList::item:selected { background: #e9eef7; border-radius: 8px; }
QPushButton#InstalledModTitle { color: #1e2a3d; font-weight: 700; }
QPushButton#InstalledModTitle:hover { color: #7658d9; }
